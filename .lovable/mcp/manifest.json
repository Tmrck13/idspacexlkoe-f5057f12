{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://smhykdoiowqtnmugclog.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "id-space-finance-v2",
      "version": "0.1.0",
      "title": "Id Space Finance V2"
    },
    "tools": [
      {
        "name": "get_my_account",
        "title": "Get my account",
        "description": "Get the signed-in user's ID•SPACE FINANCE profile, unified wallet balances (Pi, IDPoints, Cashback) and roles.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_transactions",
        "title": "List my transactions",
        "description": "List the signed-in user's ledger transactions (most recent first). Optionally filter by currency or status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many entries to return (default 20, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "currency": {
              "description": "Filter by currency.",
              "type": "string",
              "enum": [
                "pi",
                "idpoints",
                "cashback"
              ]
            },
            "status": {
              "description": "Filter by status.",
              "type": "string",
              "enum": [
                "pending",
                "success",
                "cancelled",
                "failed"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_notifications",
        "title": "List my notifications",
        "description": "List notifications visible to the signed-in user, most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "How many notifications to return (default 20, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_membership_levels",
        "title": "List membership levels",
        "description": "List the IDPI membership levels with their badges and benefits, ordered from lowest to highest.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_my_profile",
        "title": "Update my profile",
        "description": "Update the signed-in user's ID•SPACE FINANCE profile username and/or avatar URL.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "username": {
              "description": "New username (3-32 characters).",
              "type": "string"
            },
            "avatar": {
              "description": "New avatar image URL, or null to clear it.",
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
